/target
**/*.rs.bk
Cargo.lock.bak

# Model weights and generated output — never commit these.
*.safetensors
*.gguf
*.ckpt
*.bin
*.pt
*.pth
/models/
/out/
*.png
*.jpg
*.jpeg
!assets/**/*.png

# Golden reference data is large; generated locally by xtask/golden.
# The CLIP vocabulary is 2 MB of JSON and belongs here for the same reason the
# tensors do: golden tests skip when it is absent, so CI stays green without it.
/tests/golden/**/*.safetensors
/tests/golden/**/*.npz
/tests/golden/**/*.json

# Python reference environment
__pycache__/
*.py[cod]
/.venv/
/xtask/golden/.venv/

.DS_Store
.idea/
.vscode/
